# Instagram Bot - Detector de No Seguidores
# Llena tus datos aquí

# Instagram Credentials
INSTAGRAM_USERNAME=tu_usuario_aqui
INSTAGRAM_PASSWORD=tu_contraseña_aqui

# Session file path
# SESSION_FILE=session.json

# Rate Limiting (seconds) — más alto = más seguro
MIN_DELAY=2.0
MAX_DELAY=5.0

# Reintentos máximos en login
MAX_REINTENTOS=3

# Logging level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO
